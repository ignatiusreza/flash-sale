{
  "name": "flash-sale",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  "forwardPorts": [3000, 5173, 15672],
  "portsAttributes": {
    "3000": { "label": "api" },
    "5173": { "label": "web" },
    "15672": { "label": "rabbitmq management" }
  },

  "//": "corepack enable needs root in this image — /usr/local/bin is not writable by `node` — and the image's own pnpm would otherwise shadow the packageManager pin.",
  "postCreateCommand": "sudo corepack enable && pnpm install --frozen-lockfile",
  "remoteUser": "node",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "eslint.useFlatConfig": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
