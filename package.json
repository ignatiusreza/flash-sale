{
  "name": "flash-sale",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @flash-sale/web build",
    "dev": "node scripts/dev.mjs",
    "migrate": "pnpm --filter @flash-sale/worker migrate",
    "seed": "pnpm --filter @flash-sale/worker seed",
    "clean": "tsc -b --clean && rm -rf apps/web/dist",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && pnpm --filter @flash-sale/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "pnpm audit --audit-level=high",
    "licenses:check": "node scripts/check-licenses.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm licenses:check && pnpm audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
